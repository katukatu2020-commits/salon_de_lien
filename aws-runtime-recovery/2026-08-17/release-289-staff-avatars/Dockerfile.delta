ARG BASE_IMAGE=009293460979.dkr.ecr.ap-northeast-1.amazonaws.com/salon-de-lien-staging-app@sha256:330f5d22df4c96c6aaa11bed4b14ae7471af7511e33e610c3ee3425ffec6ac60
FROM ${BASE_IMAGE}

USER root
WORKDIR /app
COPY --chown=nextjs:nodejs patch-runtime.mjs /tmp/lien-patch-runtime.mjs
RUN node /tmp/lien-patch-runtime.mjs /app && rm /tmp/lien-patch-runtime.mjs
COPY --chown=nextjs:nodejs verify-runtime.cjs /tmp/lien-verify-runtime.cjs
RUN node /tmp/lien-verify-runtime.cjs && rm /tmp/lien-verify-runtime.cjs
USER nextjs
