    "if_template_size_differs": "Scale x/y/w/h by target_width/1055 and target_height/1491; scale font_size by min(scale_x, scale_y). Prefer preparing and rendering at exactly 1055x1491."
  },
  "production_rules": {
    "render_engine": "Use a deterministic renderer such as Pillow/ImageMagick/SVG. Do not use an image-generation model to edit pixels.",
    "recommended_pipeline": [
      "1. Use coupon_template_clean_v2.png as the fixed base template.",
      "2. Read values from JSON/CSV.",
      "3. Draw only the fields listed in fields.",
      "4. Clip every text layer to its bbox.",
      "5. Validate that pixels outside the editable union mask are unchanged."
    ],
    "output_format": "PNG",
    "jpeg_policy": "Never save intermediate files as JPEG. Convert to JPEG only at final export if absolutely necessary.",
    "font_policy": "Production must use the exact original fonts assigned to each font_role. If a production font file is missing, stop with an error instead of silently substituting.",
    "overflow_policy": "Start from max_font_size. If the rendered visual bbox exceeds the field bbox, decrease font_size by 1 px until it fits, not below min_font_size. If still too large, stop with an error.",
    "customer_name_policy": "The fixed Japanese suffix '様だけの' is not moved or redrawn. The customer_name field is right-aligned so the gap before '様だけの' remains stable even when the name length changes.",
    "target_menu_policy": "Bullets and dotted lines are part of the template. Do not erase or redraw them. Draw menu item text inside the line_boxes only."
  },
