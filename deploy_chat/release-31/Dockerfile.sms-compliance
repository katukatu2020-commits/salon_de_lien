FROM 009293460979.dkr.ecr.ap-northeast-1.amazonaws.com/salon-de-lien-staging-app:customer-premium-calendar-sales-20260812-24
USER root
COPY patch-customer-brand-shell.js /tmp/
COPY patch-customer-interactions.js /tmp/
COPY patch-sms-compliance.js /tmp/
COPY verify-sms-compliance.js /tmp/
COPY sms-compliance-migration.sql /app/sms-compliance-migration.sql
RUN node /tmp/patch-customer-brand-shell.js \
  && node /tmp/patch-customer-interactions.js \
  && node /tmp/patch-sms-compliance.js \
  && mkdir -p /app/prisma/migrations/20260813093000_add_sms_compliance \
  && cp /app/sms-compliance-migration.sql /app/prisma/migrations/20260813093000_add_sms_compliance/migration.sql \
  && node --check /app/server.js \
  && node --check /app/.next/server/chunks/2241.js \
  && node --check /app/.next/server/chunks/9845.js \
  && node /tmp/verify-sms-compliance.js \
  && grep -q 'ACCOUNT_VERIFICATION_OTP' /app/.next/server/chunks/2241.js \
  && grep -q 'smsTransactionalOptIn' /app/server.js \
  && grep -q 'SMS一斉配信は利用できません' /app/.next/server/chunks/9845.js \
  && mkdir -p /app/.next/cache \
  && chown -R nextjs:nodejs /app/.next/cache
USER nextjs
WORKDIR /app
CMD ["node", "server.js"]
