generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                           String                       @id
  slug                         String                       @unique
  name                         String
  createdAt                    DateTime                     @default(now())
  updatedAt                    DateTime                     @default(now()) @updatedAt
  iconImageUrl                 String?
  taxRate                      Int                          @default(10)
  defaultCouponDiscountRate    Int                          @default(10)
  referralReferrerDiscountRate Int                          @default(15)
  referralReferredDiscountRate Int                          @default(20)
  pointDefaultValidDays        Int                          @default(40)
  pointMinimumRedeem           Int                          @default(1)
  pointMaxRedemptionPercent    Int                          @default(50)
  reviewPrizeFirstPoints       Int                          @default(1000)
  reviewPrizeFirstRate         Int                          @default(1)
  reviewPrizeSecondPoints      Int                          @default(200)
  reviewPrizeSecondRate        Int                          @default(9)
  reviewPrizeThirdPoints       Int                          @default(80)
  reviewPrizeThirdRate         Int                          @default(90)
  couponDefaultValidDays       Int                          @default(14)
  couponMaxValidDays           Int                          @default(20)
  couponMinimumDiscountRate    Int                          @default(5)
  couponMaximumDiscountRate    Int                          @default(30)
  users                        AppUser[]
  ChatThread                   ChatThread[]
  customers                    Customer[]
  customerBroadcasts           CustomerBroadcast[]
  customerRegistrationInvites  CustomerRegistrationInvite[]
  customerStoreLinks           CustomerStoreLink[]
  billing                      OrganizationBilling?
  products                     Product[]
  SmsSendLog                   SmsSendLog[]
  staffBookingSettings         StaffBookingSetting[]
  visitCommunityPosts          VisitCommunityPost[]
}

model AppUser {
  id                  String                  @id @default(cuid())
  organizationId      String?
  customerId          String?                 @unique
  email               String
  passwordHash        String?
  role                AppRole
  manufacturerName    String?
  active              Boolean                 @default(true)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  loginId             String?
  displayName         String?
  customerPublicCode  String?                 @unique
  customer            Customer?               @relation(fields: [customerId], references: [id])
  organization        Organization?           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customerBroadcasts  CustomerBroadcast[]
  customerStoreLinks  CustomerStoreLink[]
  passwordResetTokens PasswordResetToken[]
  withdrawalRequests  CustomerWithdrawalRequest[]
  communityComments   VisitCommunityComment[]
  communityLikes      VisitCommunityLike[]

  @@index([organizationId, role])
  @@index([email])
  @@index([loginId])
  @@index([manufacturerName])
}

model CustomerStoreLink {
  id             String       @id @default(cuid())
  appUserId      String
  organizationId String
  customerId     String       @unique
  createdAt      DateTime     @default(now())
  appUser        AppUser      @relation(fields: [appUserId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([appUserId, organizationId])
  @@index([organizationId, createdAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  appUserId String
  tokenHash String    @unique
  audience  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  appUser   AppUser   @relation(fields: [appUserId], references: [id], onDelete: Cascade)

  @@index([appUserId, createdAt])
  @@index([expiresAt, usedAt])
}

model CustomerWithdrawalRequest {
  id         String    @id @default(cuid())
  customerId String
  appUserId  String
  email      String
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  appUser    AppUser   @relation(fields: [appUserId], references: [id], onDelete: Cascade)

  @@index([appUserId, createdAt])
  @@index([customerId, createdAt])
  @@index([expiresAt, usedAt])
}

model CustomerRegistrationInvite {
  id             String       @id @default(cuid())
  organizationId String
  customerId     String?      @unique
  email          String
  tokenHash      String       @unique
  contextJson    Json?
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime     @default(now())
  customer       Customer?    @relation(fields: [customerId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, email, createdAt])
  @@index([expiresAt, usedAt])
}

model Customer {
  id                       String                       @id @default(cuid())
  name                     String
  gender                   String?
  birthYear                Int?
  phone                    String?
  memo                     String?
  createdAt                DateTime                     @default(now())
  updatedAt                DateTime                     @updatedAt
  profileImageUrl          String?
  deletedAt                DateTime?
  storeHiddenAt            DateTime?
  aiFrontImageUrl          String?
  aiSideImageUrl           String?
  aiBackImageUrl           String?
  aiPhotoConsent           Boolean                      @default(false)
  aiFrontImageUrlsJson     String?
  aiSideImageUrlsJson      String?
  aiBackImageUrlsJson      String?
  referredByCustomerId     String?
  servicePreference        String?
  staffAssignmentType      String?
  assignedStaffName        String?
  organizationId           String                       @default("org_salon_de_lien")
  birthDate                DateTime?
  phoneVerifiedAt          DateTime?
  smsTransactionalOptIn    Boolean                      @default(false)
  smsTransactionalOptInAt  DateTime?
  smsTransactionalOptOutAt DateTime?
  smsConsentSource         String?
  appUsers                 AppUser?
  appointments             Appointment[]
  AutomatedCouponGrant     AutomatedCouponGrant[]
  ChatThread               ChatThread[]
  consents                 Consent[]
  contactLogs              ContactLog[]
  coupons                  Coupon[]
  couponIssues             CouponIssue[]
  courseRecommendations    CourseRecommendation[]
  organization             Organization                 @relation(fields: [organizationId], references: [id])
  broadcastRecipients      CustomerBroadcastRecipient[]
  customerOffers           CustomerOffer[]
  storeLink                CustomerStoreLink?
  phoneIdentity            CustomerPhoneIdentity?
  pointAccount             CustomerPointAccount?
  portalAccesses           CustomerPortalAccess[]
  registrationInvite       CustomerRegistrationInvite?
  hairProfile              HairProfile?
  partnerCoupons           PartnerCoupon[]
  pendingPointRewards      PendingPointReward[]
  pointLots                PointLot[]
  pointTransactions        PointTransaction[]
  preference               Preference?
  productProposals         ProductProposal[]
  productSuggestions       ProductSuggestion[]
  proposalResponses        ProposalResponse[]
  referralsReceived        Referral[]                   @relation("ReferralReferred")
  referralsMade            Referral[]                   @relation("ReferralReferrer")
  serviceSales             ServiceSale[]
  SmsSendLog               SmsSendLog[]
  styleSuggestions         StyleSuggestion[]
  visits                   Visit[]
  communityPosts           VisitCommunityPost[]
  visitPhotos              VisitPhoto[]
  withdrawalRequests       CustomerWithdrawalRequest[]

  @@index([organizationId, deletedAt])
  @@index([organizationId, storeHiddenAt, deletedAt])
  @@index([referredByCustomerId])
}

model CustomerPhoneIdentity {
  id             String   @id @default(cuid())
  organizationId String
  customerId     String   @unique
  phoneE164      String
  verifiedAt     DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([organizationId, phoneE164])
  @@unique([organizationId, phoneE164], map: "CustomerPhoneIdentity_org_phone_compliance_key")
  @@index([phoneE164])
}

model SmsVerificationChallenge {
  id                    String    @id @default(cuid())
  organizationId        String
  phoneE164             String
  codeHash              String
  registrationTokenHash String?
  requestIpHash         String?
  expiresAt             DateTime
  verifiedAt            DateTime?
  consumedAt            DateTime?
  attempts              Int       @default(0)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  sentAt                DateTime?
  smsProvider           String?
  smsMessageId          String?
  smsStatus             String?

  @@index([organizationId, phoneE164, createdAt])
  @@index([requestIpHash, createdAt])
  @@index([expiresAt, consumedAt])
}

model CustomerPortalAccess {
  id         String    @id @default(cuid())
  customerId String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, expiresAt])
  @@index([expiresAt, revokedAt])
}

model HairProfile {
  id                 String   @id @default(cuid())
  customerId         String   @unique
  hairThickness      String?
  hairVolume         String?
  hairTexture        String?
  scalpCondition     String?
  faceShape          String?
  forehead           String?
  lifestyle          String?
  stylingTimeMinutes Int?
  updatedAt          DateTime @updatedAt
  hairCurl           String?
  customer           Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model Preference {
  id               String   @id @default(cuid())
  customerId       String   @unique
  preferredLength  String?
  preferredStyle   String?
  dislikes         String?
  colorPreference  String?
  maintenanceLevel String?
  referenceNotes   String?
  customer         Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model Visit {
  id                    String                 @id @default(cuid())
  customerId            String
  visitedAt             DateTime
  stylistName           String?
  requestedStyle        String?
  performedStyle        String?
  cutNotes              String?
  colorNotes            String?
  permNotes             String?
  customerReaction      String?
  nextRecommendation    String?
  coupons               Coupon[]
  courseRecommendations CourseRecommendation[]
  productProposals      ProductProposal[]
  styleSuggestions      StyleSuggestion[]
  customer              Customer               @relation(fields: [customerId], references: [id], onDelete: Cascade)
  communityPost         VisitCommunityPost?
  photos                VisitPhoto[]

  @@index([customerId, visitedAt])
}

model VisitCommunityPost {
  id             String                  @id @default(cuid())
  organizationId String
  customerId     String?
  visitId        String?                 @unique
  postKind       String                  @default("VISIT")
  caption        String?
  photoReferences String[]               @default([])
  publishedByName String?
  published      Boolean                 @default(true)
  publishedAt    DateTime                @default(now())
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  aiCommentDueAt DateTime?
  aiCommentedAt  DateTime?
  comments       VisitCommunityComment[]
  likes          VisitCommunityLike[]
  customer       Customer?               @relation(fields: [customerId], references: [id], onDelete: Cascade)
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  visit          Visit?                  @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([organizationId, published, publishedAt])
  @@index([customerId, publishedAt])
  @@index([organizationId, published, aiCommentDueAt, aiCommentedAt], map: "VisitCommunityPost_organizationId_published_aiCommentDueAt_aiCo")
}

model VisitCommunityLike {
  id        String             @id @default(cuid())
  postId    String
  appUserId String
  createdAt DateTime           @default(now())
  appUser   AppUser            @relation(fields: [appUserId], references: [id], onDelete: Cascade)
  post      VisitCommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, appUserId])
  @@index([appUserId, createdAt])
}

model VisitCommunityComment {
  id                String             @id @default(cuid())
  postId            String
  appUserId         String?
  authorDisplayName String
  authorRole        AppRole
  isStylistComment  Boolean            @default(false)
  body              String
  deletedAt         DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  isAiAssistant     Boolean            @default(false)
  appUser           AppUser?           @relation(fields: [appUserId], references: [id])
  post              VisitCommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, deletedAt, createdAt])
  @@index([postId, isAiAssistant, deletedAt])
  @@index([appUserId, createdAt])
}

model VisitPhoto {
  id               String   @id @default(cuid())
  customerId       String
  visitId          String
  storageReference String   @unique
  caption          String?
  uploadedByUserId String?
  uploadedByName   String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  customer         Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  visit            Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
  @@index([visitId, createdAt])
}

model StyleSuggestion {
  id                 String             @id @default(cuid())
  customerId         String
  visitId            String?
  suggestedStyleName String
  reason             String?
  caution            String?
  stylingAdvice      String?
  accepted           Boolean            @default(false)
  createdAt          DateTime           @default(now())
  imageUrls          String[]           @default([])
  menuSuggestion     String?
  estimatedMinutes   Int?
  maintenanceLevel   String?
  label              String?
  imageUrlsJson      String?
  faceAnalysis       String?
  imagePrompt        String?
  archivedAt         DateTime?
  proposalResponses  ProposalResponse[]
  customer           Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  visit              Visit?             @relation(fields: [visitId], references: [id])

  @@index([customerId, createdAt])
  @@index([customerId, archivedAt, createdAt])
}

model CourseRecommendation {
  id               String   @id @default(uuid())
  customerId       String
  visitId          String?
  title            String
  reason           String
  caution          String?
  estimatedMinutes Int?
  estimatedPrice   Int?
  priority         String?
  accepted         Boolean  @default(false)
  createdAt        DateTime @default(now())
  customer         Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  visit            Visit?   @relation(fields: [visitId], references: [id])

  @@index([customerId, createdAt])
  @@index([visitId])
}

model ContactLog {
  id                String    @id @default(cuid())
  customerId        String
  channel           String
  purpose           String?
  message           String
  outcome           String?
  nextAction        String?
  scheduledFollowUp DateTime?
  createdAt         DateTime  @default(now())
  customer          Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
  @@index([scheduledFollowUp])
}

model Appointment {
  id                  String               @id @default(cuid())
  customerId          String
  scheduledAt         DateTime
  menu                String?
  estimatedPrice      Int?
  status              String               @default("仮予約")
  source              String?
  note                String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  staffName           String?
  durationMinutes     Int?
  bookingProvider     String?
  couponIssueId       String?              @unique
  customer            Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  couponIssue         CouponIssue?          @relation(fields: [couponIssueId], references: [id], onDelete: SetNull)
  serviceSales        ServiceSale[]
  SmsAppointmentState SmsAppointmentState?
  SmsSendLog          SmsSendLog[]

  @@index([customerId, scheduledAt])
  @@index([scheduledAt])
  @@index([bookingProvider, scheduledAt])
}

model StaffBookingSetting {
  id                        String       @id @default(cuid())
  organizationId            String
  staffKey                  String
  staffName                 String
  maxConcurrentAppointments Int          @default(1)
  workStartMinutes          Int          @default(600)
  workEndMinutes            Int          @default(1140)
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt
  organization              Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, staffKey])
  @@index([organizationId, staffName])
}

model ServiceSale {
  id            String            @id @default(cuid())
  customerId    String
  appointmentId String?
  title         String
  amount        Int
  paymentMethod String?
  paidAt        DateTime          @default(now())
  source        String?
  note          String?
  createdAt     DateTime          @default(now())
  productLines  ProductSaleLine[]
  appointment   Appointment?      @relation(fields: [appointmentId], references: [id])
  customer      Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, paidAt])
  @@index([appointmentId])
  @@index([paidAt])
}

model CustomerOffer {
  id                 String              @id @default(cuid())
  customerId         String
  title              String
  offerType          String              @default("salon")
  description        String?
  benefit            String?
  couponCode         String?
  expectedRevenue    Int?
  status             String              @default("draft")
  reactionStatus     String?
  reactionNote       String?
  validFrom          DateTime?
  validUntil         DateTime?
  publishedAt        DateTime?
  redeemedAt         DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  customer           Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  partnerCoupons     PartnerCoupon[]
  productSuggestions ProductSuggestion[]

  @@index([customerId, createdAt])
  @@index([status, validUntil])
}

model ProductSuggestion {
  id             String         @id @default(cuid())
  customerId     String
  offerId        String?
  productName    String
  category       String?
  makerName      String?
  reason         String?
  estimatedPrice Int?
  status         String         @default("proposed")
  reactionStatus String?
  reactionNote   String?
  purchasedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  customer       Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  offer          CustomerOffer? @relation(fields: [offerId], references: [id])

  @@index([customerId, createdAt])
  @@index([offerId])
  @@index([status])
}

model Product {
  id                        String            @id @default(cuid())
  manufacturerName          String
  name                      String
  category                  String?
  concernTags               Json?
  description               String?
  active                    Boolean           @default(true)
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt
  organizationId            String            @default("org_salon_de_lien")
  retailPrice               Int
  stockQuantity             Int               @default(0)
  alternativeRecommendation String?
  salesSuspended            Boolean           @default(false)
  salesStagnant             Boolean           @default(false)
  campaignTags              Json?
  imageUrl                  String?
  organization              Organization      @relation(fields: [organizationId], references: [id])
  proposals                 ProductProposal[]
  saleLines                 ProductSaleLine[]

  @@unique([organizationId, manufacturerName, name])
  @@index([organizationId, active])
  @@index([manufacturerName])
  @@index([active])
  @@index([category])
}

model ProductSaleLine {
  id                       String      @id @default(cuid())
  serviceSaleId            String
  productId                String
  productNameSnapshot      String
  manufacturerNameSnapshot String
  unitPrice                Int
  quantity                 Int
  lineTotal                Int
  createdAt                DateTime    @default(now())
  product                  Product     @relation(fields: [productId], references: [id])
  serviceSale              ServiceSale @relation(fields: [serviceSaleId], references: [id], onDelete: Cascade)

  @@unique([serviceSaleId, productId])
  @@index([productId, createdAt])
  @@index([serviceSaleId])
}

model ProductProposal {
  id             String                 @id @default(cuid())
  customerId     String
  productId      String
  visitId        String?
  staffId        String?
  proposalReason String?
  concernTags    Json?
  status         String                 @default("proposed")
  reaction       String?
  purchased      Boolean                @default(false)
  note           String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  customer       Customer               @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product        Product                @relation(fields: [productId], references: [id])
  visit          Visit?                 @relation(fields: [visitId], references: [id])
  reviews        ProductReview[]
  reviewRequests ProductReviewRequest[]

  @@index([customerId, createdAt])
  @@index([productId, createdAt])
  @@index([visitId])
  @@index([status])
  @@index([reaction])
}

model ProductReviewRequest {
  id                String          @id @default(cuid())
  productProposalId String
  tokenHash         String          @unique
  expiresAt         DateTime
  requestedAt       DateTime        @default(now())
  answeredAt        DateTime?
  status            String          @default("active")
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  review            ProductReview?
  productProposal   ProductProposal @relation(fields: [productProposalId], references: [id], onDelete: Cascade)

  @@index([productProposalId, requestedAt])
  @@index([status, expiresAt])
}

model ProductReview {
  id                  String               @id @default(cuid())
  productProposalId   String
  reviewRequestId     String               @unique
  usedStatus          String
  rating              Int?
  goodPoints          Json?
  badPoints           Json?
  repeatIntent        String?
  freeComment         String?
  allowAnonymousShare Boolean              @default(false)
  allowAnonymousQuote Boolean              @default(false)
  submittedAt         DateTime             @default(now())
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  consents            Consent[]
  productProposal     ProductProposal      @relation(fields: [productProposalId], references: [id], onDelete: Cascade)
  reviewRequest       ProductReviewRequest @relation(fields: [reviewRequestId], references: [id], onDelete: Cascade)

  @@index([productProposalId, submittedAt])
  @@index([usedStatus])
  @@index([allowAnonymousShare])
}

model Consent {
  id              String         @id @default(cuid())
  customerId      String?
  productReviewId String?
  consentType     String
  granted         Boolean        @default(true)
  source          String?
  createdAt       DateTime       @default(now())
  customer        Customer?      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productReview   ProductReview? @relation(fields: [productReviewId], references: [id], onDelete: Cascade)

  @@index([customerId, consentType])
  @@index([productReviewId])
  @@index([consentType, createdAt])
}

model CustomerPointAccount {
  id               String             @id @default(cuid())
  customerId       String             @unique
  availablePoints  Int                @default(0)
  pendingPoints    Int                @default(0)
  lifetimeEarned   Int                @default(0)
  lifetimeRedeemed Int                @default(0)
  lifetimeExpired  Int                @default(0)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  customer         Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  transactions     PointTransaction[]

  @@index([availablePoints])
}

model PendingPointReward {
  id               String    @id @default(cuid())
  customerId       String
  sourceType       String
  sourceId         String
  amount           Int
  status           String    @default("pending")
  eligibleAfter    DateTime
  expiresAt        DateTime
  claimedAt        DateTime?
  claimContextType String?
  claimContextId   String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  customer         Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([sourceType, sourceId])
  @@index([customerId, status, expiresAt])
  @@index([status, eligibleAfter, expiresAt])
}

model PointTransaction {
  id                    String                      @id @default(cuid())
  customerId            String
  accountId             String
  type                  String
  amount                Int
  balanceAfter          Int
  sourceType            String
  sourceId              String?
  reason                String
  note                  String?
  expiresAt             DateTime?
  createdByStaffId      String?
  createdAt             DateTime                    @default(now())
  earnedLots            PointLot[]                  @relation("PointLotEarnTransaction")
  redemptionAllocations PointRedemptionAllocation[] @relation("PointRedeemTransaction")
  account               CustomerPointAccount        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  customer              Customer                    @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([sourceType, sourceId, type])
  @@index([customerId, createdAt])
  @@index([accountId, createdAt])
  @@index([type, createdAt])
  @@index([sourceType, sourceId])
}

model PointLot {
  id                    String                      @id @default(cuid())
  customerId            String
  earnTransactionId     String
  originalAmount        Int
  remainingAmount       Int
  expiresAt             DateTime
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  customer              Customer                    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  earnTransaction       PointTransaction            @relation("PointLotEarnTransaction", fields: [earnTransactionId], references: [id], onDelete: Cascade)
  redemptionAllocations PointRedemptionAllocation[]

  @@index([customerId, expiresAt])
  @@index([earnTransactionId])
  @@index([remainingAmount])
}

model PointRedemptionAllocation {
  id                  String           @id @default(cuid())
  redeemTransactionId String
  pointLotId          String
  amount              Int
  createdAt           DateTime         @default(now())
  pointLot            PointLot         @relation(fields: [pointLotId], references: [id], onDelete: Cascade)
  redeemTransaction   PointTransaction @relation("PointRedeemTransaction", fields: [redeemTransactionId], references: [id], onDelete: Cascade)

  @@index([redeemTransactionId])
  @@index([pointLotId])
}

