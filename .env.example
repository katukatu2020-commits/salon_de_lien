DATABASE_URL="postgresql://salon:salon_password@localhost:5432/salon_de_lien?schema=public"
APP_ENV="development"
DEFAULT_ORGANIZATION_ID="org_salon_de_lien"
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Customer portal IDs are accepted only for local compatibility when explicitly enabled.
# Keep this false in staging and production.
ALLOW_LEGACY_CUSTOMER_ID_PORTAL="true"

# Customer photos. Production must use s3; local development may use vercel-blob.
STORAGE_PROVIDER="vercel-blob"
AWS_REGION="ap-northeast-1"
S3_PRIVATE_ASSETS_BUCKET=""
S3_SIGNED_URL_TTL_SECONDS="300"

# Manufacturer privacy threshold. Attribute breakdowns and quotes are suppressed below this count.
MANUFACTURER_MIN_SAMPLE_SIZE="5"
BLOB_READ_WRITE_TOKEN=""
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"
OPENAI_IMAGE_MODEL="gpt-image-1.5"
ENABLE_STYLE_IMAGE_GENERATION="false"
STYLE_SIMULATION_PROVIDER="openai"
# Experimental providers:
# STYLE_SIMULATION_PROVIDER="fal-identity-master"
# STYLE_SIMULATION_PROVIDER="fal-identity-master-openai-edit"
FAL_KEY=""
FAL_STYLE_MODEL="photomaker"
ENABLE_IDENTITY_MASTER_GENERATION="true"
ALLOW_UNMASKED_HAIR_EDIT_FALLBACK="false"

# Management authentication. Generate secure local values with:
# npm run setup:admin-auth
ADMIN_EMAIL="owner@salon-de-lien.local"
ADMIN_LOGIN_ID="lien"
ADMIN_PASSWORD_HASH=""
ADMIN_AUTH_SECRET=""
ADMIN_SESSION_HOURS="12"

# Encrypts per-store integration credentials such as LINE channel secrets.
# Use a different 32+ character value in production. When omitted, the runtime
# temporarily derives a key from ADMIN_AUTH_SECRET for backward compatibility.
INTEGRATION_SECRET_ENCRYPTION_KEY=""

# Customer app authentication. Use a different 32+ character secret in production.
CUSTOMER_AUTH_SECRET=""
CUSTOMER_SESSION_DAYS="30"

# New customer phone verification. Production must use aws-sns.
# ECS uses its task role, so do not add static AWS access keys.
SMS_PROVIDER="console"
SMS_VERIFICATION_SECRET=""
SMS_SENDER_ID="SalonLien"
# 1通あたりの許容上限額（USD）。AWS側の送信単価が上限を超える場合は送信しません。
SMS_MAX_PRICE_USD="0.20"
# Local development only. Never enable this in staging or production.
SMS_DEV_SHOW_CODE="false"

# Password reset links are one-time and stored as SHA-256 hashes.
PASSWORD_RESET_TOKEN_MINUTES="30"
PASSWORD_RESET_MAIL_FROM_NAME="Salon de Lien"
# Real recovery mailbox used when bootstrapping the store-side AppUser.
PASSWORD_RESET_ADMIN_EMAIL=""

# Customer registration links are one-time and expire before profile/SMS setup.
CUSTOMER_REGISTRATION_TOKEN_MINUTES="60"

# Optional local-only short login. The API rejects this login when APP_ENV=production.
ENABLE_TEST_ADMIN_LOGIN="false"
TEST_ADMIN_ID=""
TEST_ADMIN_PASSWORD_HASH=""

# Gmail reservation sync. Gmail API uses OAuth 2.0; never set the Gmail password here.
GMAIL_RESERVATION_EMAIL="reservation@example.com"
GMAIL_RESERVATION_SUBJECT="新規のご予約が確定しました"
GMAIL_RESERVATION_SENDER="kanzashi@pacificporter.jp"
# Comma-separated sender domains/addresses used by HOT PEPPER Beauty or SALON BOARD notices.
GMAIL_HOTPEPPER_RESERVATION_SENDERS="salonboard.com,beauty.hotpepper.jp,recruit.co.jp"
GMAIL_OAUTH_CLIENT_ID=""
GMAIL_OAUTH_CLIENT_SECRET=""
GMAIL_OAUTH_REFRESH_TOKEN=""
GMAIL_AUTO_SYNC_ENABLED="false"
GMAIL_SYNC_INTERVAL_SECONDS="60"
GMAIL_SYNC_LOOKBACK_DAYS="30"
GMAIL_SYNC_CRON_SECRET=""
GMAIL_SYNC_ORGANIZATION_ID="org_salon_de_lien"

# Chrome browser bridge (legacy local fallback). Gmail API/OAuth is the normal integration.
# Generate the secret and the untracked extension config with:
# npm run setup:gmail-browser-bridge
GMAIL_BROWSER_INGEST_SECRET=""
GMAIL_BROWSER_INGEST_ORGANIZATION_ID="org_salon_de_lien"
