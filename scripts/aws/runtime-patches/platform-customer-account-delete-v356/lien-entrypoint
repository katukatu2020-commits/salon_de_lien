#!/bin/sh
set -eu

if [ -z "${DATABASE_URL:-}" ] && [ -n "${DB_HOST:-}" ]; then
  : "${DB_PORT:=5432}"
  : "${DB_NAME:=salon_de_lien}"
  : "${DB_SCHEMA:=public}"
  : "${DB_USER:?DB_USER is required when DATABASE_URL is not set}"
  : "${DB_PASSWORD:?DB_PASSWORD is required when DATABASE_URL is not set}"

  ENCODED_DB_USER="$(node -p 'encodeURIComponent(process.argv[1])' "$DB_USER")"
  ENCODED_DB_PASSWORD="$(node -p 'encodeURIComponent(process.argv[1])' "$DB_PASSWORD")"
  export DATABASE_URL="postgresql://${ENCODED_DB_USER}:${ENCODED_DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=${DB_SCHEMA}&sslmode=require"
fi

node /app/ensure-platform-account-actions.cjs
exec /usr/local/bin/lien-entrypoint-v355 "$@"
