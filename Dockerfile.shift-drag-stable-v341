ARG BASE_IMAGE=salon-de-lien:customer-store-selection-v340
FROM ${BASE_IMAGE}

USER root

COPY scripts/aws/runtime-patches/shift-drag-stable-v341/patch-runtime.mjs /tmp/shift-drag-stable-v341.mjs
COPY scripts/aws/runtime-patches/shift-drag-stable-v341/verify-runtime.mjs /tmp/verify-shift-drag-stable-v341.mjs

RUN node /tmp/shift-drag-stable-v341.mjs \
 && node /tmp/verify-shift-drag-stable-v341.mjs \
 && rm -f /tmp/shift-drag-stable-v341.mjs /tmp/verify-shift-drag-stable-v341.mjs

USER nextjs
